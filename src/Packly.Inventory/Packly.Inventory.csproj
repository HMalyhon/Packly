<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <Description>Simulated stock reservation and packing.</Description>
  </PropertyGroup>

  <!-- Stateless, like the payment worker: it answers commands and holds nothing,
       so it needs no database and no transactional outbox. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.RabbitMQ" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Packly.Contracts\Packly.Contracts.csproj" />
    <ProjectReference Include="..\Packly.Messaging\Packly.Messaging.csproj" />
  </ItemGroup>

</Project>
