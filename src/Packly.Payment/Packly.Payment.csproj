<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <Description>Simulated payment authorization.</Description>
  </PropertyGroup>

  <!--
    No database, unlike the API and the orchestrator. Those two have state to keep
    consistent with what they publish and so need the transactional outbox and its
    Entity Framework package; this service holds none, so there is no transaction
    for a message to join. It still uses the in-memory outbox, which is a different
    thing: that one only defers publishes until the consumer succeeds.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="MassTransit.RabbitMQ" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Packly.Contracts\Packly.Contracts.csproj" />
    <ProjectReference Include="..\Packly.Messaging\Packly.Messaging.csproj" />
  </ItemGroup>

</Project>
