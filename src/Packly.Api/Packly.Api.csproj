<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Both sides of the CQRS split meet here, and only here: writes go to SQL Server
    through Entity Framework, queries to MongoDB through the read model. The two
    never touch - no endpoint reads one and writes the other. Framework and
    language settings come from Directory.Build.props; package versions from
    Directory.Packages.props.
  -->

  <PropertyGroup>
    <Description>Order submission API.</Description>
    <UserSecretsId>packly-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit.RabbitMQ" />
    <!-- Supplies the transactional outbox that ties publishing to the same
         transaction as the order row. -->
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- The query endpoints name its builders directly, so it is declared here
         rather than relied on through Packly.ReadModel's own reference. -->
    <PackageReference Include="MongoDB.Driver" />
    <!-- Design-time only: needed by `dotnet ef migrations`, not at runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Generates the OpenAPI document and serves the UI, so reviewers can
         exercise the API without reaching for curl. -->
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <!-- Only this service handles HTTP, so only this one traces it. -->
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
  </ItemGroup>

  <!-- The validation rules are internal: nothing outside this assembly calls them,
       and the tests are the only reason they are reachable at all. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Packly.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Packly.Contracts\Packly.Contracts.csproj" />
    <ProjectReference Include="..\Packly.Messaging\Packly.Messaging.csproj" />
    <ProjectReference Include="..\Packly.ReadModel\Packly.ReadModel.csproj" />
  </ItemGroup>

</Project>
