root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,js,html,css,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

# --- Language conventions ---------------------------------------------------

csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:silent
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent

dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent

# --- Naming: private fields are _camelCase ----------------------------------

dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_prefix.capitalization = camel_case
dotnet_naming_style.underscore_prefix.required_prefix = _

# --- Analyzer tuning --------------------------------------------------------
# Three analyzer packages run over this repository and they overlap, so the rules
# below are switched off deliberately.
#
# Roslynator ships with its analyzers off, so without this line the package is
# installed but contributes nothing. 
roslynator_analyzers.enabled_by_default = true

# The comments that do exist are still validated - see GenerateDocumentationFile.
dotnet_diagnostic.CS1591.severity = none    # missing XML comment on public member
dotnet_diagnostic.SA1600.severity = none    # elements should be documented
dotnet_diagnostic.SA1601.severity = none    # partial elements should be documented

# No copyright banner on every file. The LICENSE file covers the repository.
dotnet_diagnostic.SA1633.severity = none

# These contradict conventions already set above in this same file. Leaving both
# switched on would mean the build enforcing two opposite styles at once.
dotnet_diagnostic.SA1101.severity = none    # prefix local calls with 'this.'
dotnet_diagnostic.SA1309.severity = none    # field must not begin with '_'
dotnet_diagnostic.SA1200.severity = none    # using directives inside namespace

# StyleCop orders members by accessibility; readability usually argues for keeping
# related members adjacent instead.
dotnet_diagnostic.SA1201.severity = suggestion
dotnet_diagnostic.SA1202.severity = suggestion
dotnet_diagnostic.SA1204.severity = suggestion

# --- Generated code ---------------------------------------------------------
# EF Core scaffolds migrations; they are not hand-maintained style surface.

[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
