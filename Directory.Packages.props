<Project>

  <!--
    Central package management: every NuGet version lives here, exactly once.
    Projects reference packages without a Version attribute, so eight projects
    can never drift onto different versions of MassTransit or EF Core.

    Entries are added by the commit that first needs them.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Messaging">
    <!--
      Pinned to 8.x. MassTransit 9 moved to a commercial licence, while 8.5.10 is
      Apache-2.0 and still ships native net10.0 assets - the right trade for a
      repository anyone should be able to clone and run.
    -->
    <PackageVersion Include="MassTransit" Version="8.5.10" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.10" />
    <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="8.5.10" />
  </ItemGroup>

  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <!--
      StyleCop 1.1.x is the newest stable release, but it predates file-scoped
      namespaces, records and nullable reference types and misfires on all three.
      1.2.0-beta is the build the ecosystem actually uses on modern C#.
    -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.30.0.144632" />
  </ItemGroup>

</Project>
