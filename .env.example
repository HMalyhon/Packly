# Copy to .env to override any of the defaults baked into docker-compose.yml.
# Nothing here is required: the stack runs without a .env file at all.
#
# These are local development credentials for throwaway containers. Real secrets
# belong in a secret store, not a file in the repository.

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=packly
RABBITMQ_PASSWORD=packly
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- SQL Server (write model, outbox, saga state) ---------------------------
# Must satisfy SQL Server's complexity policy or the container exits on startup.
MSSQL_SA_PASSWORD=Packly!Local1
MSSQL_PORT=1433

# --- MongoDB (read model) ---------------------------------------------------
MONGO_USER=packly
MONGO_PASSWORD=packly
MONGO_PORT=27017

# --- API --------------------------------------------------------------------
API_PORT=8080
